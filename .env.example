# ==============================================================================
# Riti Handlooms — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` for local development, or enter the VITE_* variables
# in Vercel Project Settings > Environment Variables for production deployment.
#
# SECURITY WARNING:
# - NEVER place Sanity write tokens, API secrets, or private keys in VITE_* vars.
# - Everything prefixed with VITE_ is bundled into public client-side JavaScript.
# ==============================================================================

# --- Sanity CMS (Public Read-Only Storefront Configuration) ---
VITE_SANITY_PROJECT_ID=YOUR_SANITY_PROJECT_ID
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# --- Public Site & SEO Configuration ---
# Replace with your live Vercel or custom domain (no trailing slash)
VITE_SITE_URL=https://YOUR_DOMAIN.com

# --- Business Contact & WhatsApp Enquiry Configuration ---
# WhatsApp number in international format with country code, no '+' or spaces
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
VITE_CONTACT_PHONE=+91 XXXXX XXXXX
VITE_CONTACT_EMAIL=contact@YOUR_DOMAIN.com
VITE_INSTAGRAM_URL=https://instagram.com/YOUR_INSTAGRAM_HANDLE

# --- Store Location Fallback (overridden by Sanity Site Settings if published) ---
VITE_STORE_ADDRESS=YOUR_SHOP_ADDRESS

# ==============================================================================
# Sanity Studio CLI / Hosting Variables (studio/ directory — NOT for Vercel frontend)
# Set these in your shell or `studio/.env` when running or deploying Sanity Studio.
# ==============================================================================
SANITY_STUDIO_PROJECT_ID=YOUR_SANITY_PROJECT_ID
SANITY_STUDIO_DATASET=production
